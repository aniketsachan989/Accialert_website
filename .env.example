# ==============================================================================
# AcciAlert Web Platform - Environment Configuration
# ==============================================================================

# Next.js Public URL
NEXT_PUBLIC_APP_URL=https://accialert-website.vercel.app

# Firebase Client Configuration (Already bundled in lib/firebase.ts, optional overrides)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=accialertapp-9f6c9

# ==============================================================================
# Silent High-Priority Email Alert Configuration (SMTP / Gmail App Password)
# ==============================================================================
# To send physical emails directly to blood bank inboxes with zero cost:
# 1. Go to your Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Generate an App Password for "AcciAlert Emergency" (16 letters, e.g. "abcd efgh ijkl mnop")
# 3. Paste your Gmail and App Password below, and set them in your Vercel Project Settings!

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-emergency-dispatch@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="AcciAlert Hema-Link Emergency" <your-emergency-dispatch@gmail.com>
